{
  "name": "clevertree-chat",
  "private": true,
  "scripts": {
    "chat:host": "python3 scripts/chat_host.py 8790",
    "demo:server": "python3 scripts/demo_server.py 8945",
    "test:unit": "python3 -m unittest discover -s tests -v && node tests/test_extension_normalize.js && node tests/test_website_href_js.js",
    "test:e2e": "playwright test tests/e2e/chat-websocket.spec.ts tests/e2e/website-url-room.spec.ts",
    "test:e2e:a11y": "playwright test tests/e2e/a11y-contrast.spec.ts",
    "test:e2e:thc": "playwright test tests/e2e/chat-websocket.spec.ts",
    "test:all": "npm run test:unit && npm run test:e2e && npm run test:e2e:a11y",
    "smoke:live": "bash scripts/smoke_live_host.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.49.0",
    "axe-core": "^4.14.0"
  }
}
