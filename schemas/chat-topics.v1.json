{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clevertree.chat-topics.v1",
  "title": "Clevertree chat topic index",
  "type": "object",
  "required": ["schema", "irc_channel", "topics"],
  "properties": {
    "schema": { "const": "clevertree.chat-topics.v1" },
    "irc_channel": { "type": "string", "pattern": "^#[a-z0-9._-]+$" },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "slug", "title", "href"],
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "slug": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "href": { "type": "string", "minLength": 1 },
          "retired": { "type": "boolean" }
        }
      }
    }
  }
}
