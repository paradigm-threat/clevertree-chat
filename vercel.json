{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/try/flock-cameras", "destination": "/try" },
    { "source": "/try/thc-legalization", "destination": "/try" }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/downloads/clevertree-chat-extension.zip",
      "headers": [
        { "key": "Content-Type", "value": "application/zip" },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"clevertree-chat-extension.zip\""
        },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ],
  "functions": {
    "api/debate.py": {
      "maxDuration": 60
    },
    "api/demo.py": {
      "maxDuration": 30
    }
  }
}
