{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/try/:path+", "destination": "/try" }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    }
  ],
  "functions": {
    "api/debate.py": {
      "maxDuration": 60
    },
    "api/demo.py": {
      "maxDuration": 30
    }
  }
}
