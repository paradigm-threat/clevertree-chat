{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/trees",
      "destination": "/forest",
      "permanent": true
    },
    {
      "source": "/trees/",
      "destination": "/forest",
      "permanent": true
    },
    {
      "source": "/try",
      "destination": "/chat",
      "permanent": true
    },
    {
      "source": "/try/",
      "destination": "/chat",
      "permanent": true
    },
    {
      "source": "/try/:path*",
      "destination": "/chat",
      "permanent": true
    },
    {
      "source": "/w",
      "destination": "/chat",
      "permanent": true
    },
    {
      "source": "/w/",
      "destination": "/chat",
      "permanent": true
    },
    {
      "source": "/w/:path*",
      "destination": "/chat",
      "permanent": true
    },
    {
      "source": "/chat/flock-cameras",
      "destination": "/chat",
      "permanent": true
    },
    {
      "source": "/chat/thc-legalization",
      "destination": "/chat",
      "permanent": true
    },
    {
      "source": "/chat/5g",
      "destination": "/chat",
      "permanent": true
    },
    {
      "source": "/chat/geoengineering",
      "destination": "/chat",
      "permanent": true
    },
    {
      "source": "/chat/general",
      "destination": "/chat",
      "permanent": true
    },
    {
      "source": "/forest.html",
      "destination": "/forest",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/downloads/clevertree-chat-extension.zip",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/zip"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"clevertree-chat-extension.zip\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "functions": {
    "api/debate.py": {
      "maxDuration": 60
    },
    "api/demo.py": {
      "maxDuration": 30
    }
  }
}
