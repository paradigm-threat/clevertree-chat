# Copied to /opt/clevertree-chat/chat-host.env on pub1 (not committed with secrets).
CLEVERTREE_LIVE_ROOT=/opt/clevertree-chat/var/clevertree-live
CLEVERTREE_COMMENTS_PATH=/opt/clevertree-chat/var/clevertree-live/comments
CLEVERTREE_AUTH_PATH=/opt/clevertree-chat/var/clevertree-live/auth
CLEVERTREE_GIT_FALLBACK=1
CLEVERTREE_SEED_FIXTURES=0
CLEVERTREE_FETCH=1
CLEVERTREE_SPOT_WAKE=0
CLEVERTREE_CHANNEL_ASR=1
# Demo without Groq: stub in-channel transcripts.
CLEVERTREE_ASR_DRY_RUN=1
# Paste Groq key on pub1 (never commit real values). Used for Whisper ASR + text SI.
# GROQ_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3
# GROQ_TEXT_MODEL=llama-3.1-8b-instant
# Text SI: Groq free tier first; auto-failover to Bedrock on 429 / rate-limit (and 5xx).
# CLEVERTREE_PROVIDER_FAILOVER=1
# CLEVERTREE_BEDROCK_FAILOVER_ON_5XX=1
# CLEVERTREE_BEDROCK_REGION=us-east-1
# CLEVERTREE_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# ASR caveat: Whisper has no Bedrock drop-in — stay Groq or CLEVERTREE_ASR_DRY_RUN.
CLEVERTREE_PUBLISH_REMOTES=git://pub1.relaygateway.net:9418/clevertree-chat-comments.git
CLEVERTREE_IRC_ENABLE=1
CLEVERTREE_IRC_HOST=127.0.0.1
CLEVERTREE_IRC_PORT=6667
CLEVERTREE_IRC_TLS=0
CLEVERTREE_IRC_NICK=clevertree-si
CLEVERTREE_IRC_PREFIX=pt
CLEVERTREE_IRC_CONSOLIDATE_PT=1
CLEVERTREE_IRC_BOT_NICKS=clevertree-si,clevertree-ai,clevertree,relay-bot
