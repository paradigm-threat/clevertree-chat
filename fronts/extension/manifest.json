{
  "manifest_version": 3,
  "name": "Clevertree Chat",
  "version": "0.1.0",
  "description": "Debate the page you’re on. Empty until you write. Simplified Debate board matching the web demos.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Clevertree Chat",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "tabs", "activeTab"],
  "host_permissions": [
    "https://intake.myproblem.app/*",
    "http://127.0.0.1:8790/*",
    "http://localhost:8790/*"
  ]
}
